---
import "../styles/global.css";
import HeaderComponent from "../components/header.astro";
import FooterComponent from "../components/footer.astro";
import HeadSeo from "../components/meta/HeadSeo.astro";

const { title, description, image, article } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <HeadSeo
            title={title}
            description={description}
            image={image}
            article={article}
        />
    </head>
    <body>
        <div class="grid grid-cols-12 gap-0 justify-stretch align-stretch min-h-screen grid-rows-[48px_auto_73px] md:grid-rows-[72px_auto_73px]">
            <div class="col-span-12">
                <HeaderComponent />
            </div>
            <div class="hidden md:block md:col-span-1">&nbsp;</div>
            <main class="col-span-12 md:col-span-10 p-2 lg:p-4">
                <slot />
            </main>
            <div class="hidden md:block md:col-span-1"></div>
            <div class="col-span-12 max-width-mx">
                <FooterComponent />
            </div>
        </div>
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
