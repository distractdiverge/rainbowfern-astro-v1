---
import { Image } from "astro:assets";
import rainbowFernLogo from "../assets/fern-colors-web.svg";
import MobileNav from "../components/mobile_nav.astro";
import DesktopNav from "../components/desktop_nav.astro";
const navigationLinks = [
    {
        title: "About",
        to: "/",
    },
    {
        title: "Projects",
        to: "/projects",
    },
    {
        title: "Experience",
        to: "/experience",
    },
    {
        title: "Education",
        to: "/education",
    },
    {
        title: "Contact",
        to: "/contact",
    },
];
const path = Astro.url.pathname;
---

<header class="header sticky top-0 z-10 bg-white flex h-[var(--header-h)] justify-between p-1 shadow-md">
    <a href="/" class="flex mt-2 ml-2 mb-3 lg:mb-0">
        <Image
            src={rainbowFernLogo}
            alt="Rainbowfern logo"
            class="block mt-2 ml-1 mr-2 max-w-[20px] max-h-[20px]"
        />

        <h1 class="block mt-2 mr-2 text-s md:text-base">Rainbowfern.com</h1>
    </a>

    <!-- Desktop Navigation Menu -->
    <nav id="desktop-menu" class="hidden md:flex">
        {navigationLinks.map(({ title, to }: { title: string; to: string }) => (
            <a
                class="text-xs md:text-base block px-1 py-3 mb-0 hover:text-gray-400 hover:underline"
                href={to}
            >
                {title}
            </a>
        ))}
    </nav>

    <button
        type="button"
        class="hamburger flex h-10 w-10 cursor-pointer flex-col items-center justify-center gap-1.5 rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-300"
        popovertarget="mobile-menu"
        popovertargetaction="toggle"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
    >
        <span class="bar block h-0.5 w-6 rounded-full bg-current"></span>
        <span class="bar block h-0.5 w-6 rounded-full bg-current"></span>
        <span class="bar block h-0.5 w-6 rounded-full bg-current"></span>
    </button>
</header>

<nav
    id="mobile-menu"
    popover="auto"
    aria-label="Main"
    class="bg-gray-900 text-gray-50 shadow-2xl"
>
    <ul class="flex flex-col gap-1">
        {navigationLinks.map((link) => (
            <li>
                <a
                    href={link.to}
                    aria-current={path === link.to ? "page" : undefined}
                    class="block rounded-md px-4 py-3 text-lg hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-gray-300 aria-[current=page]:bg-gray-700 aria-[current=page]:font-semibold aria-[current=page]:text-white"
                >
                    {link.title}
                </a>
            </li>
        ))}
    </ul>
</nav>

<style>
    #mobile-menu {
        position: fixed;
        inset: auto;
        top: var(--header-h);
        right: 0;
        left: auto;
        margin: 0;
        width: min(80vw, 18rem);
        height: calc(100dvh - var(--header-h));
        padding: 1rem;
        border: 0;
        border-radius: 0;
        overflow-y: auto;

        transform: translateX(100%);
        opacity: 0;
        transition:
            transform 0.3s ease,
            opacity 0.3s ease,
            overlay 0.3s allow-discrete,
            display 0.3s allow-discrete;
    }

    #mobile-menu:popover-open {
        transform: translateX(0);
        opacity: 1;
    }

    /* Entry frame: the panel starts off-screen so it animates in on open. */
    @starting-style {
        #mobile-menu:popover-open {
            transform: translateX(100%);
            opacity: 0;
        }
    }

    /* Only dim the page below the header, so the hamburger/X stays tappable. */
    #mobile-menu::backdrop {
        background: rgb(0 0 0 / 0.35);
        clip-path: inset(var(--header-h) 0 0 0);
        transition:
            background-color 0.3s ease,
            overlay 0.3s allow-discrete,
            display 0.3s allow-discrete;
    }

    @starting-style {
        #mobile-menu:popover-open::backdrop {
            background-color: rgb(0 0 0 / 0);
        }
    }

    /* ---------- Hamburger → X (CSS only) ---------- */
    .bar {
        transform-origin: center;
        transition:
            transform 0.3s ease,
            opacity 0.2s ease;
    }

    /* The menu is open when the header's sibling popover matches :popover-open. */
    .header:has(~ #mobile-menu:popover-open) .bar:nth-child(1) {
        transform: translateY(8px) rotate(45deg);
    }

    .header:has(~ #mobile-menu:popover-open) .bar:nth-child(2) {
        opacity: 0;
    }

    .header:has(~ #mobile-menu:popover-open) .bar:nth-child(3) {
        transform: translateY(-8px) rotate(-45deg);
    }

    /* ---------- Respect reduced-motion preferences ---------- */
    @media (prefers-reduced-motion: reduce) {
        #mobile-menu,
        #mobile-menu::backdrop,
        .bar {
            transition: none;
        }
    }
</style>
